{
  "name": "dawn-boilerplate",
  "version": "1.5.0",
  "description": "a refreshed theme based on Dawn Shopify Theme V15",
  "main": "index.js",
  "repository": "git@github.com:benjaminv/dawn.git",
  "author": "ben <benvee@gmail.com>",
  "private": true,
  "license": "ISC",
  "scripts": {
    "shopify:login": "shopify theme list --store dawn-original --environment sync",
    "shopify:sync": "shopify theme pull --store dawn-original --environment sync",
    "shopify:push": "shopify theme push --store dawn-original --environment deployment",
    "deploy": "npm run build && npm run shopify:push",
    "deploy:new": "shopify theme push --store dawn-original --path ./src/theme --unpublished",
    "dev": "concurrently --raw --kill-others \"npm run dev:shopify\" \"npm run dev:vite\"",
    "dev:shopify": "shopify theme dev --store dawn-original --path ./src/theme --live-reload full-page",
    "dev:vite": "vite",
    "format": "prettier -w ./src --cache --plugin-search-dir=.",
    "build": "vite build"
  },
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^2.2.0",
    "@shopify/cli": "^3.88.1",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.97.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-mkcert": "^1.17.9",
    "vite-plugin-shopify": "^4.1.1"
  },
  "dependencies": {
    "alpinejs": "^3.15.3",
    "swiper": "^11.2.10"
  }
}
